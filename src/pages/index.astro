---
import '../styles/global.css';

const clinic = {
  name: "Ascend Renal Care",
  email: "Info@ascendrenalcare.com",
  phone: "317-400-4826",
  address: "8315 East 56th Street, Suite #120, Indianapolis, IN 46216",
  hours: "Mon • Wed & Fri: 5:00 AM – 4:30 PM",
  formspreeId: "YOUR_FORMSPREE_ID_HERE",
  availabilityBadge: "Accepting New Patients • Same-Week Intake"
};

const acceptedInsurances = [
  { name: "Medicare Part B", code: "Federal" },
  { name: "Indiana Medicaid", code: "State" },
  { name: "Anthem BCBS", code: "Commercial" },
  { name: "UnitedHealthcare", code: "Commercial" },
  { name: "Humana", code: "Commercial" },
  { name: "Private Pay & Cash Schedules", code: "Self-Pay" }
];

const clinicalServices = [
  {
    id: "hemodialysis",
    title: "In-Center Hemodialysis",
    badge: "Four-Station Specialized Clinic",
    symptoms: "End-Stage Renal Disease (ESRD) • Chronic Kidney Disease Stage 5 • Fluid Overload",
    desc: "Intimate, cubicle-style treatment stations avoiding institutional noise. Continuous 1-on-1 nephrology nursing oversight, individualized biocompatible dialyzer settings, and dedicated shift times.",
    cta: "Schedule Station Tour"
  },
  {
    id: "home-dialysis",
    title: "Home Hemodialysis & Peritoneal Support",
    badge: "Independent Patient Pathway",
    symptoms: "High Schedule Independence • Daytime Work Routines • Nocturnal Dialysis Need",
    desc: "Rigorous clinical coaching for patients and designated care partners. We coordinate cycler delivery, home plumbing/power verification, ongoing supply drops, and 24/7 direct-line telemetry nurse consultation.",
    cta: "Inquire Home Training"
  },
  {
    id: "snf-dialysis",
    title: "Skilled Nursing Facility (SNF) Programs",
    badge: "Institutional Bedside Delivery",
    symptoms: "Post-Acute Hospital Transfers • Mobility Impairment • Frequent Transportation Fatigue",
    desc: "On-site dialysis treatments conducted directly inside partnering nursing homes and rehab facilities across Greater Indianapolis. Zero stressful ambulance rides, zero missed treatments, and steady care coordination.",
    cta: "Explore Facility Partnering"
  }
];

const clinicalTeam = [
  {
    name: "Yvette Dupree, BSN, RN, CEO",
    title: "Facility Administrator & Clinical Director",
    specialty: "Renal Nursing Leadership • State Compliance & Quality Assurance",
    experience: "25+ Years Experience",
    initials: "YD"
  },
  {
    name: "Richard Russell, Sr., CEO",
    title: "Director of Biomedical Services",
    specialty: "Dialysis Water Treatment Systems • Rigorous Machine Safety Validation",
    experience: "30+ Years Experience",
    initials: "RR"
  },
  {
    name: "Meg Allen, RD",
    title: "Lead Renal Dietitian",
    specialty: "Nutritional Electrolyte Balance • Phosphorus & Potassium Management",
    experience: "15+ Years Clinical Nutrition",
    initials: "MA"
  },
  {
    name: "Turkessa Guthrie, MSW",
    title: "Dedicated Clinical Social Worker",
    specialty: "Transplant Waitlist Advocacy • Medicare Disability & Transportation Access",
    experience: "20+ Years Patient Navigation",
    initials: "TG"
  }
];

const patientTestimonials = [
  {
    quote: "Switching from a 24-chair corporate warehouse to this four-station suite changed my life. The nurses know my dry weight, my family, and my veins. No loud alarms buzzing for twenty minutes straight.",
    author: "M. Henderson",
    tenure: "Patient for 3 Years",
    verified: "Verified Treatment Tenure"
  },
  {
    quote: "They trained my daughter and me for home therapy with incredible patience. Whenever we had a midnight tubing question, their on-call nurse picked up within 3 rings.",
    author: "D. Caldwell",
    tenure: "Patient for 18 Months",
    verified: "Verified Treatment Tenure"
  }
];

const schemaJson = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "name": clinic.name,
  "telephone": clinic.phone,
  "email": clinic.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "8315 East 56th Street, Suite #120",
    "addressLocality": "Indianapolis",
    "addressRegion": "IN",
    "postalCode": "46216",
    "addressCountry": "US"
  },
  "openingHours": "Mo,We,Fr 05:00-16:30"
};
---

<html lang="en" class="scroll-smooth bg-[#FFFFFF]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{clinic.name} | Deficiency-Free Dialysis & Home Therapy Indianapolis</title>
    <meta name="description" content="State-certified deficiency-free renal clinic in Indianapolis specializing in hemodialysis, home therapy, and nursing home programs." />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />

    <style>
      /* Subdued, purposeful bidirectional micro-motion */
      .scroll-fade {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
      }
      .scroll-fade.is-active {
        opacity: 1;
        transform: translateY(0);
      }

      .font-mono-archival {
        font-family: 'JetBrains Mono', monospace;
      }

      /* Glassmorphism 2.0 tactile depth */
      .glass-panel-light {
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(122, 54, 40, 0.14);
        box-shadow: 0 10px 25px -5px rgba(122, 54, 40, 0.05);
      }
    </style>
  </head>

  <body class="bg-[#FFFFFF] text-[#4E4E4E] font-['Plus_Jakarta_Sans',sans-serif] selection:bg-[#7A3628] selection:text-white antialiased">

    <!-- 1. CLINICAL UTILITY BAR -->
    <div class="bg-[#1A1A1A] text-white/90 border-b border-[#7A3628]/30 px-6 py-2.5 text-xs font-mono-archival tracking-tight">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-y-2">
        <div class="flex items-center space-x-6">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#A4D2ED] animate-pulse"></span>
            <span class="text-[#A4D2ED] font-semibold">{clinic.availabilityBadge}</span>
          </span>
          <span class="hidden lg:inline text-white/50">|</span>
          <span class="hidden lg:inline text-white/70">Facility: {clinic.address}</span>
        </div>
        <div class="flex items-center space-x-6">
          <span class="hidden md:inline text-white/70">{clinic.hours}</span>
          <span class="text-white/50 hidden md:inline">|</span>
          <a href={`mailto:${clinic.email}`} class="text-[#A4D2ED] hover:underline">{clinic.email}</a>
        </div>
      </div>
    </div>

    <!-- 2. STICKY NAVIGATION BAR -->
    <header class="sticky top-0 z-50 bg-[#1A1A1A]/95 backdrop-blur-md border-b border-white/10 px-6 py-4">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <a href="#" class="font-['Playfair_Display',serif] text-xl md:text-2xl font-bold tracking-tight text-white flex items-center gap-2">
          <span>Ascend</span>
          <span class="text-[#A4D2ED] text-base font-sans uppercase font-mono-archival tracking-widest text-[11px] border border-[#A4D2ED]/30 px-2 py-0.5 rounded">Renal Care</span>
        </a>

        <nav class="hidden md:flex items-center space-x-7 text-xs uppercase tracking-widest font-semibold text-white/80">
          <a href="#about" class="hover:text-[#A4D2ED] transition">About Clinic</a>
          <a href="#services" class="hover:text-[#A4D2ED] transition">Clinical Services</a>
          <a href="#insurance" class="hover:text-[#A4D2ED] transition">Coverage</a>
          <a href="#team" class="hover:text-[#A4D2ED] transition">Care Team</a>
          <a href="#reviews" class="hover:text-[#A4D2ED] transition">Outcomes</a>
          <a href="#contact" class="hover:text-[#A4D2ED] transition">Intake</a>
        </nav>

        <div class="flex items-center gap-4">
          <a href={`tel:${clinic.phone}`} class="hidden sm:inline text-white font-mono-archival text-xs font-bold tracking-wider hover:text-[#A4D2ED] transition">
            {clinic.phone}
          </a>
          <a 
            href="#contact" 
            class="bg-white hover:bg-[#7A3628] text-[#1A1A1A] hover:text-white font-bold text-xs uppercase tracking-widest px-5 py-2.5 rounded border-2 border-[#C68A36] transition duration-200 active:scale-95 shadow-md"
          >
            Request Consultation
          </a>
        </div>
      </div>
    </header>

    <!-- 3. HERO -->
    <section class="relative min-h-[85vh] flex items-center justify-center pt-24 pb-20 px-6 bg-[#1A1A1A] text-white overflow-hidden border-b-4 border-[#7A3628]">
      <div class="absolute inset-0 opacity-25 bg-[radial-gradient(#7A3628_1.5px,transparent_1.5px)] [background-size:24px_24px]"></div>
      
      <div class="relative z-10 max-w-4xl mx-auto text-center scroll-fade">
        <div class="inline-flex items-center gap-2 border border-[#A4D2ED]/40 bg-[#A4D2ED]/10 px-4 py-1.5 rounded mb-8">
          <span class="w-1.5 h-1.5 rounded-full bg-[#A4D2ED]"></span>
          <p class="text-[#A4D2ED] font-mono-archival text-xs tracking-wider uppercase font-semibold">
            Certified Deficiency-Free Facility • State of Indiana
          </p>
        </div>
        
        <h1 class="font-['Playfair_Display',serif] text-4xl sm:text-6xl md:text-7xl font-bold text-white tracking-tight leading-[1.1] mb-8">
          Hemodialysis and <br class="hidden sm:block" />Home Therapy
        </h1>
        
        <p class="text-base sm:text-lg text-white/80 max-w-2xl mx-auto leading-relaxed mb-10">
          Specialized clinical care for End-Stage Renal Disease (ESRD) and Acute Kidney Injury (AKI). An intimate 4-station environment that treats patients like family, not numbers.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="#contact" 
            class="w-full sm:w-auto bg-white hover:bg-[#7A3628] text-[#1A1A1A] hover:text-white font-bold px-8 py-4 uppercase tracking-widest text-xs rounded border-2 border-[#C68A36] transition duration-200 shadow-xl active:scale-95"
          >
            Request Intake Consultation
          </a>
          <a 
            href="#services" 
            class="w-full sm:w-auto border border-white/30 hover:border-white text-white px-8 py-4 uppercase tracking-widest text-xs rounded transition duration-200 font-semibold"
          >
            Explore Treatment Models
          </a>
        </div>
      </div>
    </section>

    <!-- 4. EMBOSSED BRAND PILLARS -->
    <section class="border-b border-[#7A3628]/20 bg-[#141414] py-12 px-6">
      <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 text-center scroll-fade">
        <div class="border-b md:border-b-0 md:border-r border-white/10 pb-6 md:pb-0 md:pr-6">
          <p class="font-['Playfair_Display',serif] text-3xl sm:text-4xl font-bold tracking-widest text-[#A4D2ED] drop-shadow-sm">
            EMPATHETIC
          </p>
          <p class="text-xs uppercase tracking-wider font-mono-archival text-white/60 mt-2">Dignified, unhurried bedside manner</p>
        </div>
        <div class="border-b md:border-b-0 md:border-r border-white/10 pb-6 md:pb-0 md:pr-6">
          <p class="font-['Playfair_Display',serif] text-3xl sm:text-4xl font-bold tracking-widest text-[#A4D2ED] drop-shadow-sm">
            PROFICIENT
          </p>
          <p class="text-xs uppercase tracking-wider font-mono-archival text-white/60 mt-2">90+ cumulative clinical years</p>
        </div>
        <div>
          <p class="font-['Playfair_Display',serif] text-3xl sm:text-4xl font-bold tracking-widest text-[#A4D2ED] drop-shadow-sm">
            DEDICATED
          </p>
          <p class="text-xs uppercase tracking-wider font-mono-archival text-white/60 mt-2">Proactive transplant list placement</p>
        </div>
      </div>
    </section>

    <!-- 5. ABOUT CLINIC -->
    <section id="about" class="bg-[#FFFFFF] text-[#4E4E4E] py-24 px-6 border-b border-gray-200">
      <div class="max-w-5xl mx-auto scroll-fade">
        <div class="flex items-center gap-3 mb-3">
          <span class="h-px w-8 bg-[#7A3628]"></span>
          <span class="text-xs uppercase tracking-widest text-[#7A3628] font-mono-archival font-bold">Documented Standard of Care</span>
        </div>
        
        <h2 class="font-['Playfair_Display',serif] text-3xl sm:text-5xl font-bold text-[#1A1A1A] leading-tight mb-8">
          A deficiency-free renal clinic designed to operate like a family.
        </h2>

        <div class="grid md:grid-cols-12 gap-10 items-start">
          <div class="md:col-span-7 space-y-5 text-base sm:text-lg leading-relaxed text-[#4E4E4E]">
            <p>
              Our facility has earned a distinction as a <strong>deficiency-free facility</strong> by the State of Indiana[span_0](start_span)[span_0](end_span). Backed by a multidisciplinary team offering more than 90 years of combined dialysis experience, our clinical staff consults, initiates, and oversees precision renal programs tailored to the whole person[span_1](start_span)[span_1](end_span).
            </p>
            <p class="text-base text-[#4E4E4E]/90">
              Unlike large corporate institutions running 20+ stations simultaneously, we operate an intimate, cubicle-style four-station clinic[span_2](start_span)[span_2](end_span). Our Medical Director is a leading nephrologist renowned for aggressive hypertension maintenance and steadfast advocacy in securing patient placement on regional kidney transplant registries[span_3](start_span)[span_3](end_span).
            </p>
          </div>

          <div class="md:col-span-5 space-y-4">
            <div class="glass-panel-light p-6 rounded-lg border-l-4 border-[#7A3628] scroll-fade">
              <span class="text-xs uppercase font-mono-archival tracking-wider text-[#7A3628] font-bold">Institutional Capability</span>
              <h3 class="font-['Playfair_Display',serif] text-lg font-bold text-[#1A1A1A] mt-1 mb-2">Nursing Home Bedside Services</h3>
              <p class="text-xs text-[#4E4E4E] leading-relaxed">
                We provide turnkey, in-house dialysis treatments within partnering nursing home facilities[span_4](start_span)[span_4](end_span). This eliminates transport exhaustion and keeps patient continuity stable[span_5](start_span)[span_5](end_span).
              </p>
            </div>

            <div class="glass-panel-light p-6 rounded-lg border-l-4 border-[#C68A36] scroll-fade">
              <span class="text-xs uppercase font-mono-archival tracking-wider text-[#C68A36] font-bold">Clinical Priority</span>
              <h3 class="font-['Playfair_Display',serif] text-lg font-bold text-[#1A1A1A] mt-1 mb-2">Transplant Waitlist Management</h3>
              <p class="text-xs text-[#4E4E4E] leading-relaxed">
                We handle laboratory workups, scheduling, and coordinate continuous updates directly with transplant centers throughout Indiana[span_6](start_span)[span_6](end_span).
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. GRANULAR CLINICAL SERVICES -->
    <section id="services" class="bg-[#FBFBFB] py-24 px-6 border-b border-gray-200">
      <div class="max-w-6xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-16 scroll-fade">
          <div class="flex items-center justify-center gap-2 mb-2">
            <span class="h-px w-6 bg-[#7A3628]"></span>
            <span class="text-xs uppercase tracking-widest text-[#7A3628] font-mono-archival font-bold">Granular Service Index</span>
            <span class="h-px w-6 bg-[#7A3628]"></span>
          </div>
          <h2 class="font-['Playfair_Display',serif] text-3xl sm:text-4xl font-bold text-[#1A1A1A]">
            Tailored Treatment Pathways
          </h2>
          <p class="text-xs sm:text-sm text-[#4E4E4E] mt-3">Dedicated clinical pathways mapped to patient lifestyle and medical requirements.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {clinicalServices.map((svc) => (
            <div class="bg-white border border-gray-200 hover:border-[#7A3628] p-8 rounded-lg shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between scroll-fade group">
              <div>
                <span class="text-[11px] font-mono-archival font-bold uppercase tracking-wider text-[#7A3628] bg-[#7A3628]/10 px-2.5 py-1 rounded">
                  {svc.badge}
                </span>
                <h3 class="font-['Playfair_Display',serif] text-2xl font-bold text-[#1A1A1A] mt-4 mb-3 group-hover:text-[#7A3628] transition">
                  {svc.title}
                </h3>
                
                <div class="my-4 bg-gray-50 border border-gray-100 p-3 rounded text-[11px] text-[#4E4E4E] font-mono-archival">
                  <span class="text-[#7A3628] font-bold block mb-1">INDICATION PROFILE:</span>
                  {svc.symptoms}
                </div>

                <p class="text-xs sm:text-sm text-[#4E4E4E] leading-relaxed">
                  {svc.desc}
                </p>
              </div>

              <div class="pt-6 mt-8 border-t border-gray-100">
                <a 
                  href="#contact" 
                  class="w-full block text-center bg-[#1A1A1A] hover:bg-[#7A3628] text-white font-bold text-xs uppercase tracking-widest py-3 rounded transition duration-200 active:scale-98"
                >
                  {svc.cta} →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. FRICTION REDUCTION: INSURANCE MATRIX -->
    <section id="insurance" class="bg-white py-16 px-6 border-b border-gray-200">
      <div class="max-w-5xl mx-auto scroll-fade text-center">
        <span class="text-xs uppercase font-mono-archival tracking-widest text-[#7A3628] font-bold">Direct Verification</span>
        <h2 class="font-['Playfair_Display',serif] text-2xl sm:text-3xl font-bold text-[#1A1A1A] mt-1 mb-8">
          Accepted Insurance & Payment Clearances
        </h2>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
          {acceptedInsurances.map((ins) => (
            <div class="border border-gray-200 bg-gray-50/70 p-4 rounded text-center transition hover:border-[#7A3628]/40">
              <span class="block text-[10px] font-mono-archival uppercase text-[#7A3628] font-semibold">{ins.code}</span>
              <span class="text-xs font-bold text-[#1A1A1A] mt-1 block leading-tight">{ins.name}</span>
            </div>
          ))}
        </div>

        <p class="text-xs text-[#4E4E4E] mt-6 max-w-xl mx-auto">
          Need assistance verifying your coverage or deductible status? Our intake team conducts full electronic eligibility checks before your arrival.
        </p>
      </div>
    </section>

    <!-- 8. MEET OUR TEAM -->
    <section id="team" class="bg-[#7A3628] text-white py-24 px-6 border-b border-black/20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-16 scroll-fade">
          <span class="text-xs uppercase tracking-widest text-[#A4D2ED] font-mono-archival font-bold">Licensed Clinical Leadership</span>
          <h2 class="font-['Playfair_Display',serif] text-3xl sm:text-5xl font-bold text-white mt-1">
            Meet Our Care Team
          </h2>
          <p class="text-white/80 text-xs sm:text-sm mt-3">Direct, identifiable clinicians supervising every treatment session[span_7](start_span)[span_7](end_span)[span_8](start_span)[span_8](end_span).</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {clinicalTeam.map((member) => (
            <div class="bg-[#1A1A1A] border-2 border-[#C68A36]/40 rounded-lg p-6 flex flex-col justify-between shadow-2xl hover:border-white transition-all duration-300 scroll-fade">
              <div>
                <div class="w-20 h-20 rounded-full bg-[#7A3628] border-2 border-white/40 flex items-center justify-center mb-5 mx-auto">
                  <span class="font-['Playfair_Display',serif] font-bold text-2xl text-white tracking-wider">
                    {member.initials}
                  </span>
                </div>
                
                <h3 class="font-['Playfair_Display',serif] text-lg font-bold text-white text-center leading-snug">
                  {member.name}
                </h3>
                
                <p class="text-[11px] font-mono-archival text-[#A4D2ED] text-center mt-1 uppercase font-semibold">
                  {member.title}
                </p>

                <div class="mt-4 pt-4 border-t border-white/10 text-xs space-y-2 text-white/80">
                  <p><strong class="text-white">Focus:</strong> {member.specialty}</p>
                  <p class="text-[11px] font-mono-archival text-[#C68A36]">{member.experience}</p>
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-white/10">
                <a 
                  href="#contact" 
                  class="w-full block text-center bg-white hover:bg-[#7A3628] text-[#1A1A1A] hover:text-white text-[11px] font-bold uppercase tracking-wider py-2.5 rounded transition border border-[#C68A36] active:scale-95"
                >
                  Consult Specialist
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 9. SOCIAL PROOF & TENURE OUTCOMES -->
    <section id="reviews" class="bg-white py-24 px-6 border-b border-gray-200">
      <div class="max-w-5xl mx-auto scroll-fade">
        <div class="text-center mb-14">
          <span class="text-xs uppercase font-mono-archival tracking-widest text-[#7A3628] font-bold">Patient Experience & Quality Validation</span>
          <h2 class="font-['Playfair_Display',serif] text-3xl sm:text-4xl font-bold text-[#1A1A1A] mt-1">
            Real Care, Measured Over Years
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {patientTestimonials.map((t) => (
            <div class="border border-gray-200 bg-[#FBFBFB] p-8 rounded-lg relative scroll-fade hover:shadow-md transition">
              <div class="flex items-center gap-1 text-[#C68A36] mb-4">
                {"★★★★★"}
              </div>
              <p class="text-sm sm:text-base text-[#4E4E4E] italic leading-relaxed mb-6">
                "{t.quote}"
              </p>
              <div class="flex items-center justify-between border-t border-gray-200 pt-4 text-xs font-mono-archival">
                <div>
                  <span class="font-bold text-[#1A1A1A] block">{t.author}</span>
                  <span class="text-[#7A3628] font-semibold">{t.tenure}</span>
                </div>
                <span class="bg-[#A4D2ED]/30 text-[#1A1A1A] px-2 py-0.5 rounded text-[10px] font-bold">
                  {t.verified}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 10. CONTACT, MAP, & FORMSPREE INTAKE -->
    <section id="contact" class="bg-[#1A1A1A] text-white py-24 px-6 border-b-4 border-[#7A3628]">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Details & Maps -->
        <div class="lg:col-span-5 space-y-6 scroll-fade">
          <div class="border-l-4 border-[#7A3628] pl-4">
            <span class="text-xs uppercase font-mono-archival tracking-widest text-[#A4D2ED] font-bold">Direct Communication</span>
            <h2 class="font-['Playfair_Display',serif] text-3xl sm:text-4xl font-bold text-white mt-1">
              Contact Our Facility
            </h2>
          </div>
          
          <p class="text-white/80 text-sm leading-relaxed">
            We accept Medicare, Medicaid, and Commercial insurances[span_9](start_span)[span_9](end_span). If you would like to join our dialysis family, please call or schedule an intake tour[span_10](start_span)[span_10](end_span).
          </p>

          <div class="space-y-4 text-sm pt-2 font-mono-archival">
            <div>
              <p class="text-white/50 uppercase tracking-wider text-[11px]">Direct Phone</p>
              <a href={`tel:${clinic.phone}`} class="text-white text-lg font-bold hover:text-[#A4D2ED] transition">
                {clinic.phone}
              </a>
            </div>

            <div>
              <p class="text-white/50 uppercase tracking-wider text-[11px]">Direct Email</p>
              <a href={`mailto:${clinic.email}`} class="text-[#A4D2ED] hover:underline">
                {clinic.email}
              </a>
            </div>

            <div>
              <p class="text-white/50 uppercase tracking-wider text-[11px]">Physical Address</p>
              <p class="text-white/90">{clinic.address}</p>
              <a 
                href="https://maps.google.com/?q=8315+East+56th+Street+Suite+120+Indianapolis+IN+46216" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs uppercase tracking-wider text-[#A4D2ED] hover:underline mt-1 font-semibold"
              >
                Launch Google Maps Directions →
              </a>
            </div>

            <div>
              <p class="text-white/50 uppercase tracking-wider text-[11px]">Hours of Operation</p>
              <p class="text-white/90">{clinic.hours}</p>
            </div>
          </div>

          <!-- Embedded Map -->
          <div class="w-full h-44 rounded overflow-hidden border border-white/20 mt-6 grayscale contrast-125 opacity-85 hover:opacity-100 hover:grayscale-0 transition duration-300">
            <iframe 
              title="Ascend Renal Care Location Map"
              width="100%" 
              height="100%" 
              style="border:0;" 
              loading="lazy" 
              allowfullscreen 
              referrerpolicy="no-referrer-when-downgrade" 
              src="https://www.google.com/maps?q=8315+East+56th+Street+Suite+120+Indianapolis+IN+46216&output=embed">
            </iframe>
          </div>
        </div>

        <!-- Formspree Intake Form -->
        <div class="lg:col-span-7 bg-[#141414] p-8 sm:p-10 rounded-lg border-2 border-[#C68A36] relative shadow-2xl scroll-fade">
          <div class="absolute top-0 right-0 w-6 h-6 border-t-2 border-r-2 border-[#C68A36]"></div>
          <div class="absolute bottom-0 left-0 w-6 h-6 border-b-2 border-l-2 border-[#C68A36]"></div>

          <h3 class="font-['Playfair_Display',serif] text-2xl font-bold text-white mb-2">
            Schedule a Consultation
          </h3>
          <p class="text-xs text-white/70 mb-8 font-mono-archival">Direct referral & patient intake portal.</p>

          <form action={`https://formspree.io/f/${clinic.formspreeId}`} method="POST" class="space-y-6">
            <div>
              <label for="name" class="block text-xs uppercase tracking-wider font-semibold text-white/70 mb-2">Patient or Referring Family Name</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                class="w-full bg-transparent border-b border-white/30 focus:border-[#A4D2ED] py-2 text-white outline-none transition text-sm"
                placeholder="Jane Doe"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="email" class="block text-xs uppercase tracking-wider font-semibold text-white/70 mb-2">Email Address</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  class="w-full bg-transparent border-b border-white/30 focus:border-[#A4D2ED] py-2 text-white outline-none transition text-sm"
                  placeholder="jane@example.com"
                />
              </div>
              <div>
                <label for="phone" class="block text-xs uppercase tracking-wider font-semibold text-white/70 mb-2">Phone Number</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  required 
                  class="w-full bg-transparent border-b border-white/30 focus:border-[#A4D2ED] py-2 text-white outline-none transition text-sm"
                  placeholder="(317) 000-0000"
                />
              </div>
            </div>

            <div>
              <label for="service_type" class="block text-xs uppercase tracking-wider font-semibold text-white/70 mb-2">Desired Care Pathway</label>
              <select 
                id="service_type" 
                name="service_type" 
                class="w-full bg-[#1A1A1A] border-b border-white/30 focus:border-[#A4D2ED] py-2 text-white outline-none transition text-sm"
              >
                <option value="in-center">In-Center Hemodialysis (4-Station Clinic)</option>
                <option value="home-dialysis">Home Hemodialysis & Coaching</option>
                <option value="nursing-facility">Nursing Home / SNF Partnership</option>
                <option value="transplant-eval">Transplant List Inquiry</option>
              </select>
            </div>

            <div>
              <label for="notes" class="block text-xs uppercase tracking-wider font-semibold text-white/70 mb-2">Care Details or Insurance Question (Optional)</label>
              <textarea 
                id="notes" 
                name="notes" 
                rows="3" 
                class="w-full bg-transparent border-b border-white/30 focus:border-[#A4D2ED] py-2 text-white outline-none transition text-sm"
                placeholder="Details regarding current nephrologist, shift preferences, or insurance carrier..."
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full bg-white hover:bg-[#7A3628] text-[#1A1A1A] hover:text-white font-bold py-4 text-xs uppercase tracking-widest transition duration-200 rounded border-2 border-[#C68A36] shadow-xl active:scale-98"
            >
              Submit Consultation Request
            </button>

            <!-- HIPAA & Clinical Disclaimer Notice -->
            <p class="text-[11px] text-white/50 leading-relaxed pt-2 text-center">
              <strong>Notice:</strong> Submitting this electronic request does not establish a patient-physician relationship. Please do not transmit acute medical emergencies or detailed psychiatric records through this form. If you are experiencing an acute medical emergency, please dial 911 immediately.
            </p>
          </form>
        </div>

      </div>
    </section>

    <!-- 11. FOOTER -->
    <footer class="bg-[#1A1A1A] py-12 px-6 text-center text-xs text-white/60">
      <div class="max-w-4xl mx-auto space-y-4">
        <p class="font-['Playfair_Display',serif] text-lg text-white font-bold">{clinic.name}</p>
        <p class="font-mono-archival">{clinic.address} • {clinic.phone}</p>
        
        <div class="flex items-center justify-center space-x-4 pt-2">
          <a 
            href="#" 
            aria-label="Facebook Profile"
            class="w-8 h-8 rounded-full bg-[#3B5998] text-white flex items-center justify-center hover:opacity-90 transition shadow"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
            </svg>
          </a>
        </div>

        <p class="pt-4 text-white/40 font-mono-archival text-[11px]">
          © {new Date().getFullYear()} Ascend Renal Care. All rights reserved. Deficiency-Free Clinical Operation.
        </p>
      </div>
    </footer>

    <!-- 12. FLOATING EMERGENCY DIALER -->
    <a 
      href={`tel:${clinic.phone}`} 
      aria-label="Call Ascend Renal Care Clinic" 
      class="fixed bottom-6 right-6 z-40 bg-[#A4D2ED] hover:bg-[#8ec2e0] text-[#1A1A1A] p-4 rounded-full shadow-2xl flex items-center justify-center transition active:scale-95 border-2 border-white"
    >
      <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
        <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.24.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
      </svg>
    </a>

    <!-- Subdued Bidirectional Scroll Observer -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-active');
            } else {
              // Smoothly fades back out when scrolling away
              entry.target.classList.remove('is-active');
            }
          });
        },
        { 
          rootMargin: '0px 0px -60px 0px', 
          threshold: 0.12 
        }
      );

      document.querySelectorAll('.scroll-fade').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
